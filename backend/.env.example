# ResearchPilot 后端环境变量模板
#
# 用法：复制为 backend/.env 后按需修改，切勿把真实密钥提交到仓库。
#   cp backend/.env.example backend/.env
#
# 说明：backend/.env 已被 .gitignore 忽略；本文件（.env.example）需要入库。

# ---------------------------------------------------------------- 本地模型服务
# Ollama 是「可选」的：连不上或模型没下载时，后端会自动
#   1) 把嵌入降级为内置的离线哈希嵌入；
#   2) 把对话模型回落到 DEEPSEEK（若已配置 Key）。
# 想用本地模型再启动 Ollama 并拉取模型：
#   ollama pull nomic-embed-text && ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 本地对话模型
LOCAL_CHAT_MODEL=qwen2.5:7b
# 嵌入模型
EMBED_MODEL=nomic-embed-text:latest

# ---------------------------------------------------------------- 在线模型服务
# 与 Ollama 二选一即可运行：填了 Key 就走在线模式（不需要本地算力）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------- 数据目录
# Chroma 向量库路径；其同级目录会自动创建 parsed/ figures/ translated/ charts/
CHROMA_PATH=D:/ResearchPilot/data/chroma
