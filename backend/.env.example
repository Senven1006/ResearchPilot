# ResearchPilot 后端环境变量模板
#
# 用法：复制为 backend/.env 后按需修改，切勿把真实密钥提交到仓库。
#   cp backend/.env.example backend/.env
#
# 说明：backend/.env 已被 .gitignore 忽略；本文件（.env.example）需要入库。

# ---------------------------------------------------------------- 本地模型服务
# Ollama 服务地址（默认本机 11434）
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 本地对话模型（需先 ollama pull qwen2.5:7b）
LOCAL_CHAT_MODEL=qwen2.5:7b
# 嵌入模型（需先 ollama pull nomic-embed-text）
EMBED_MODEL=nomic-embed-text:latest

# ---------------------------------------------------------------- 在线模型服务
# DeepSeek API Key；留空则自动退回本地模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------- 数据目录
# Chroma 向量库路径；其同级目录会自动创建 parsed/ figures/ translated/ charts/
CHROMA_PATH=D:/ResearchPilot/data/chroma
